# LankaJourney AI — Environment Variables
# Copy this file to .env and fill in your keys.
#
#   cp .env.example .env
#
# .env is git-ignored: never commit real keys or passwords. This file must only
# ever contain placeholders — a real secret here is a leaked secret.

# ─── Retrieval backend (optional) ─────────────────────────────────────────────
# "fixtures" scores the JSON timetables in-process: deterministic, no
# infrastructure. This is what the test suite runs on, and it is the safe
# default — a route answer that depends on whether a container is up is not
# something a test can assert against.
# "opensearch" uses real BM25 + k-NN. To enable it:
#   RETRIEVER_BACKEND=opensearch
#   docker compose --profile ingest run --rm ingest     # index the corpus
# The ingest is required: BM25 over an index missing recent services returns
# nothing, and retrieval then falls back to the in-memory corpus. The answer is
# still right, but for the wrong reason — `GET /health` reports `index_freshness`
# so that is visible rather than silent. Re-run the ingest after changing
# data/processed/*.json.
#
# Dense retrieval additionally needs the planner image built with the `dense`
# build arg (docker-compose.yml already sets it). Without it the planner serves
# BM25 only and logs that it has degraded to sparse-only.
#
# Either way, retrieval falls back to fixtures with a recorded reason if the
# cluster or index is unavailable, so this cannot take route planning offline.
RETRIEVER_BACKEND=fixtures
OPENSEARCH_URL=http://localhost:9200

# ─── Human-in-the-Loop confirmation signing key ──────────────────────────────
# Required. Signs the booking confirmation tokens, so that approval is something
# the traveller returns rather than something the client asserts (R-09).
# Without it the booking agent refuses to clear the gate — it fails closed.
#   echo HITL_TOKEN_SECRET=$(openssl rand -hex 24) >> .env
HITL_TOKEN_SECRET=

# ─── OpenSearch ───────────────────────────────────────────────────────────────
# Required. docker compose refuses to start without it, so there is no default
# password to leak. Generate a random one:
#   echo OPENSEARCH_INITIAL_ADMIN_PASSWORD=$(openssl rand -base64 18) >> .env
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# ─── LLM Provider (Groq) ───────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
# Available Groq models: llama-3.1-8b-instant, llama-3.3-70b-versatile, llama3-8b-8192
GROQ_MODEL=groq/llama-3.1-8b-instant

# ─── Agent Ports ───────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8000
PLANNER_AGENT_PORT=8001
BOOKING_AGENT_PORT=8002

# ─── Agent URLs (used by orchestrator to reach sub-agents) ─────────────────────
PLANNER_AGENT_URL=http://localhost:8001
BOOKING_AGENT_URL=http://localhost:8002

# ─── Timeouts ──────────────────────────────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=10.0

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG_MODE=True

# ── Accounts ───────────────────────────────────────────────────────────────
# SQLite database for accounts and profile details. The card number is never
# stored: only the brand and last four digits (see src/orchestrator/accounts.py).
# Leave unset and the store is in-memory, so restarts lose every account.
ACCOUNTS_DB_PATH=./data/conversations/accounts.db

# Set to "off" to stop creating the demo traveller on startup.
# Demo login: demo@lankajourney.lk / demotravel123
DEMO_ACCOUNT=on

# Set to "1" when serving over HTTPS, so the session cookie is marked Secure.
COOKIE_SECURE=0

# ── Weather ───────────────────────────────────────────────────────────────
# OpenWeather API key for the Conditions Agent. Optional: with no key the agent
# uses Open-Meteo, which needs no credentials. Get one from
# https://home.openweathermap.org/api_keys — do not commit it to git.
OPENWEATHER_API_KEY=
